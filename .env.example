# Token-ul botului de la @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID-ul tău de chat (scrie botului, apoi deschide https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=123456789

# Opțional: token gratuit de la https://www.travelpayouts.com (Aviasales Data API)
# adaugă și alte companii: Turkish, Pegasus, AJet, LOT, Lufthansa...
TRAVELPAYOUTS_TOKEN=

# Plecarea: în următoarele N zile
DAYS_AHEAD=180
# Întoarcerea: între MIN și MAX zile după plecare
TRIP_MIN_DAYS=2
TRIP_MAX_DAYS=7
# Preț maxim dus-întors în EUR (0 = fără limită)
MAX_PRICE_EUR=0
# Câte destinații să trimită în mesaj
TOP_N=15
