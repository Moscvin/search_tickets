# Token-ul botului de la @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID-ul tău de chat (scrie botului, apoi deschide https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=123456789

# Opțional: token gratuit de la https://www.travelpayouts.com (Aviasales Data API)
# adaugă și alte companii: Turkish, Pegasus, AJet, LOT, Lufthansa...
TRAVELPAYOUTS_TOKEN=

# Orașele de plecare (coduri de aeroport): Chișinău, Iași, București
ORIGINS=RMO,IAS,OTP,IST
# Plecarea: în următoarele N zile
DAYS_AHEAD=180
# Întoarcerea: între MIN și MAX zile după plecare
TRIP_MIN_DAYS=2
TRIP_MAX_DAYS=7
# Doar zboruri directe (true) sau și cu escală (false)
DIRECT_ONLY=true
# Preț maxim dus-întors în EUR (0 = fără limită)
MAX_PRICE_EUR=0
# Aeroporturi căutate prin Kiwi.com (companiile fără scraper propriu); gol = lista implicită din script
KIWI_DESTINATIONS=
# Câte destinații să trimită în mesaj, pentru fiecare oraș de plecare
TOP_N=15
